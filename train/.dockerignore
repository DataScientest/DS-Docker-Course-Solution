# Fichiers à ne pas envoyer au build (et donc à ne pas copier dans l'image)

# Secrets : ne doivent jamais se retrouver dans une image
.env

# Environnements virtuels Python : lourds, et l'image installe déjà ses librairies
.venv/
venv/

# Fichiers compilés par Python, recréés automatiquement
__pycache__/
*.pyc
