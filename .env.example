# Modèle du fichier .env : copiez-le en .env, puis adaptez les valeurs.
# Docker Compose lit automatiquement le fichier .env placé à côté de compose.yaml.
# Le fichier .env, lui, ne doit jamais être versionné (il est exclu par .gitignore).

# Mots de passe de la base (valeurs de démonstration)
MARIADB_ROOT_PASSWORD=rootpass
DB_PASSWORD=apipass
